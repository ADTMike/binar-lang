fn Print(s string) {
    asm volatile("syscall" : : "{rax}" (1), "{rdi}" (1), "{rsi}" (s.ptr), "{rdx}" (s.len) : "rcx", "r11", "memory")
}

fn Println(s string) {
    Print(s)
    nl := "\n"
    asm volatile("syscall" : : "{rax}" (1), "{rdi}" (1), "{rsi}" (nl.ptr), "{rdx}" (nl.len) : "rcx", "r11", "memory")
}
