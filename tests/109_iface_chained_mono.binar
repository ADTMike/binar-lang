// exit: 60
// Tests: chained structural dispatch
import { os } from "os"

type ZapLogger {
    X int
}

fn GetVal(l ZapLogger) int {
    return l.X
}

fn Process(l ~ZapLogger) int {
    return l.GetVal()
}

fn Compute(l ~ZapLogger) int {
    v := Process(l)
    return v + 50
}

fn main() {
    z := ZapLogger{X: 10}
    os.Exit(Compute(z))
}
