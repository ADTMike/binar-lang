// exit: 50
import { os } from "os"

type ZapLogger {
    X int
}

iface Logger {
    fn GetVal(Logger)
}

fn GetVal(l ZapLogger) {
}

fn Process(l Logger) int {
    return 0
}

fn Compute(l Logger) int {
    l.GetVal()
    v := Process(l)
    return v + 50
}

fn main() {
    z := ZapLogger{X: 10}
    os.Exit(Compute(z))
}
