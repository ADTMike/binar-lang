// exit: 0
// Test defer keyword — LIFO order, works with raise
import { os } from "os"

type Myerr {
    code int
}

fn Error(e Myerr) string {
    return "error"
}

fn store(addr *int, val int) int {
    *addr = val
    return 0
}

fn inner(should_fail int) int, error {
    if should_fail != 0 {
        return 0, Myerr{code: 5}
    }
    return 42, nil
}

fn test_lifo(flag *int) int {
    defer store(flag, 1)
    defer store(flag, 2)
    return 0
}

fn test_raise(flag *int) int, error {
    defer store(flag, 99)
    // raise triggers return on error; deferred calls should still fire
    r := inner(1) raise
    return r, nil
}

fn main() {
    // Test LIFO order
    f := 0
    test_lifo(&f)
    if f != 1 { os.Exit(1) }

    // Test raise with defer
    f2 := 0
    _, err := test_raise(&f2)
    if err == nil { os.Exit(2) }
    // Deferred store should have set f2 to 99
    if f2 != 99 { os.Exit(3) }

    os.Exit(0)
}
