// exit: 0
// Test raise keyword for error propagation

type Myerr {
    code int
}

fn Error(e Myerr) string {
    return "error"
}

fn div(a int, b int) int, error {
    if b == 0 {
        return 0, Myerr{code: 1}
    }
    return a / b, nil
}

fn inner() int, error {
    // raise: propagate error from div
    x := div(10, 2) raise
    return x + 100, nil
}

fn main() {
    // Test raise with success
    r, err := inner()
    if err != nil {
        os.Exit(1)
    }
    if r != 105 {
        os.Exit(2)
    }

    // Test that div with zero causes error
    _, err2 := div(1, 0)
    if err2 == nil {
        os.Exit(3)
    }

    os.Exit(0)
}
