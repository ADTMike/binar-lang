// exit: 10
// Tests: method call through structural type
import { os } from "os"

type Counter {
    Val int
}

fn Increment(l Counter) {
}

fn Process(l ~Counter) int {
    l.Increment()
    l.Increment()
    l.Increment()
    return 10
}

fn main() {
    c := Counter{Val: 0}
    os.Exit(Process(c))
}
