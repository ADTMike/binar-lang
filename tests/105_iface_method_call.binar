// exit: 10
import { os } from "os"

type Counter {
    Val int
}

iface Logger {
    fn Increment(Logger)
}

fn Increment(l Counter) {
}

fn Process(l Logger) int {
    l.Increment()
    l.Increment()
    l.Increment()
    return 10
}

fn main() {
    c := Counter{Val: 0}
    os.Exit(Process(c))
}
