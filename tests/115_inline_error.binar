// exit: 0
// Test basic error inline: function returning error is inlined at call site
import { os } from "os"

type Myerr {
    code int
}

fn Error(e Myerr) string {
    return "error"
}

fn get_error() error {
    return Myerr{code: 42}
}

fn caller() error {
    get_error() raise
    return nil
}

fn main() {
    os.Exit(0)
}
