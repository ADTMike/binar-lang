// exit: 0
// Test: binding raise on multi-return (T, error) function is OK (positive case)
import { os } from "os"

type Myerr {
    code int
}

fn Error(e Myerr) string {
    return "error"
}

fn div(a int, b int) int, error {
    if b == 0 {
        return 0, Myerr{code: 1}
    }
    return a / b, nil
}

fn caller() int, error {
    x := div(10, 2) raise
    return x + 100, nil
}

fn main() {
    result, err := caller()
    if err != nil {
        os.Exit(1)
    }
    if result != 105 {
        os.Exit(2)
    }
    os.Exit(0)
}
