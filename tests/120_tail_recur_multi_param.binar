// exit: 15
// Test tail recursion with accumulator: sum(5, 0) = 1+2+3+4+5 = 15
// Uses pointer param to store result since error is now an interface type

type SumErr {
    code int
}

fn Error(e SumErr) string {
    return "sum"
}

fn sum(n int, acc int, result *int) error {
    if n <= 0 {
        *result = acc
        return SumErr{code: acc}
    }
    return sum(n - 1, acc + n, result)
}

fn main() {
    result := 0
    sum(5, 0, &result)
    os.Exit(result)
}
