// exit: 0
// Test: defer inside inlined function with raise executes before return

type Myerr {
    code int
}

fn Error(e Myerr) string {
    return "error"
}

fn store(addr *int, val int) {
    *addr = val
}

fn noop(flag *int) error {
    defer store(flag, 99)
    return nil
}

fn caller(flag *int) error {
    noop(flag) raise
    return nil
}

fn main() {
    flag := 0
    caller(&flag)
    if flag != 99 {
        os.Exit(1)
    }
    os.Exit(0)
}
