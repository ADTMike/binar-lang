// exit: 0
// Tests: ==, !=, <, >, <=, >=, &&, ||, !, chaining
import { os } from "os"

fn check(expected int, actual int) {
    if expected != actual {
        os.Exit(1)
    }
}

fn main() {
    r := 0
    if 10 < 20 { r = 1 }
    check(1, r)
    r = 0
    if 20 > 10 { r = 1 }
    check(1, r)
    r = 0
    if 10 == 10 { r = 1 }
    check(1, r)
    r = 0
    if 10 != 20 { r = 1 }
    check(1, r)
    r = 0
    if 10 <= 10 { r = 1 }
    check(1, r)
    r = 0
    if 10 >= 10 { r = 1 }
    check(1, r)
    r = 0
    if 10 < 5 { r = 1 }
    check(0, r)
    r = 0
    if 10 > 20 { r = 1 }
    check(0, r)
    r = 0
    if 10 == 10 && 20 == 20 { r = 1 }
    check(1, r)
    r = 0
    if 10 == 10 && 20 != 20 { r = 1 }
    check(0, r)
    r = 0
    if 10 == 10 || 20 == 30 { r = 1 }
    check(1, r)
    r = 0
    if 10 == 20 || 20 == 30 { r = 1 }
    check(0, r)
    r = 0
    if !0 { r = 1 }
    check(1, r)
    r = 0
    if !1 { r = 1 }
    check(0, r)
    r = 0
    if 0 == 0 && 0 == 0 { r = 1 }
    check(1, r)
    r = 0
    if 0 == 0 || 1 == 0 { r = 1 }
    check(1, r)
    r = 0
    if 10 == 10 && 10 == 10 && 0 == 0 { r = 1 }
    check(1, r)
    x := 5
    y := 10
    z := 15
    r = 0
    if x < y && y < z { r = 1 }
    check(1, r)
}
