// exit: 30
// Tests: multiple methods on structural type
import { os } from "os"

type ZapLogger {
    X int
    Y int
}

fn GetX(l ZapLogger) int {
    return l.X
}

fn GetY(l ZapLogger) int {
    return l.Y
}

fn Sum(l ~ZapLogger) int {
    return l.GetX() + l.GetY()
}

fn main() {
    z := ZapLogger{X: 10, Y: 20}
    os.Exit(Sum(z))
}
