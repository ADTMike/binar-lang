// exit: 2
// Test chained error propagation: source → middle → main via non-raise inlining

type Myerr {
    code int
}

fn Error(e Myerr) string {
    return "error"
}

fn source() error {
    return Myerr{code: 2}
}

fn middle() error {
    err := source()
    return err
}

fn main() {
    err := middle()
    if err != nil {
        os.Exit(2)
    }
    os.Exit(0)
}
