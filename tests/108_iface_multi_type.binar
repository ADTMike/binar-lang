// exit: 42
// Tests: multiple types with structural dispatch
import { os } from "os"

type ZapLogger {
    X int
}

type ConsoleLogger {
    X int
}

fn GetVal(l ZapLogger) int {
    return l.X
}

fn GetVal(l ConsoleLogger) int {
    return l.X
}

fn Process(l ~ZapLogger) int {
    return l.GetVal()
}

fn main() {
    z := ZapLogger{X: 10}
    c := ConsoleLogger{X: 32}
    v1 := Process(z)
    v2 := Process(c)
    os.Exit(v1 + v2)
}
