// exit: 0
// Test: tail recursion inside if/else branches

type CountdownErr {
    code int
}

fn Error(e CountdownErr) string {
    return "countdown"
}

fn count_down(n int) error {
    if n <= 0 {
        return nil
    } else {
        return count_down(n - 1)
    }
}

fn main() {
    err := count_down(10)
    if err != nil {
        os.Exit(1)
    }
    os.Exit(0)
}
